# Copie para .env.local e preencha. NENHUM valor real entra neste arquivo —
# ele é versionado justamente para dizer QUAIS chaves existem, sem dizer
# quanto valem.
#
# Atalho: com a CLI da Vercel logada no projeto, `vercel env pull .env.local`
# traz tudo já preenchido, e é o caminho recomendado ao montar uma máquina
# nova. Preencher à mão só quando não houver acesso à Vercel.

# ── Supabase ────────────────────────────────────────────────────────────────
# URL e chave anônima são públicas (vão no JavaScript do navegador).
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço: ignora RLS. NUNCA no navegador, nunca num arquivo
# versionado. É ela que a vitrine da Loja Online e as rotas de servidor usam.
SUPABASE_SERVICE_ROLE_KEY=

# ── Endereços ───────────────────────────────────────────────────────────────
# Base do ERP, usada para montar link absoluto (e-mail, WhatsApp, webhook).
# Sem valor, o código cai em https://www.sistemavargas.com.br.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Domínio raiz das lojas online. VAZIO é seguro e é o padrão em
# desenvolvimento: sem ele, nenhum host é tratado como loja (o proxy falha
# fechado de propósito — ver docs/loja-online-fase1.md).
NEXT_PUBLIC_LOJA_DOMINIO_RAIZ=

# ── Integrações ─────────────────────────────────────────────────────────────
# Claude: geração de conteúdo de anúncio, conferência de imagem, reposição.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Mercado Pago: cobrança da assinatura e webhook de pagamento.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ── Crons ───────────────────────────────────────────────────────────────────
# Segredo que autoriza /api/cron/*. A Vercel envia como
# `Authorization: Bearer <valor>`. Sem ele, toda rota de cron recusa — o que
# é o comportamento certo, inclusive em desenvolvimento.
CRON_SECRET=
